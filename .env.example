VLLM_BASE_URL=http://vllm:8000
POSTGRES_DSN=postgresql+asyncpg://inferra:inferra@postgres:5432/inferra
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
ADMIN_SECRET=dev-admin-secret-change-me

# Real RunPod vLLM — set this before running integrate.sh or the real overlay.
# Obtain from the pod: cloudflared tunnel --url http://localhost:8000
VLLM_PUBLIC_URL=https://your-tunnel-url.trycloudflare.com

# CORS — comma-separated list of allowed origins for the browser UI.
# Default covers both Vite dev (:5173) and preview (:4173).
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
