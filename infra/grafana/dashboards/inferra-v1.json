{
  "title": "Inferra V1",
  "uid": "inferra-v1",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per minute",
      "description": "rate(inference_requests_total[1m]) by status",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "rate(inference_requests_total[1m])", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "TTFT — P50 / P95 / P99",
      "description": "Time to first token percentiles",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(inference_ttft_seconds_bucket[5m])) by (le))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, sum(rate(inference_ttft_seconds_bucket[5m])) by (le))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, sum(rate(inference_ttft_seconds_bucket[5m])) by (le))", "legendFormat": "P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Total Latency — P50 / P95 / P99",
      "description": "End-to-end request latency percentiles",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(inference_total_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, sum(rate(inference_total_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, sum(rate(inference_total_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prompt tokens / minute",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 7},
      "targets": [{"expr": "rate(inference_prompt_tokens_total[1m])", "legendFormat": "{{tenant_id}}"}],
      "fieldConfig": {"defaults": {"unit": "tokens/s", "min": 0}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Completion tokens / minute",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 7},
      "targets": [{"expr": "rate(inference_completion_tokens_total[1m])", "legendFormat": "{{tenant_id}}"}],
      "fieldConfig": {"defaults": {"unit": "tokens/s", "min": 0}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Output tokens/s (per request P50/P95)",
      "description": "Token generation throughput",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 7},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(inference_output_tokens_per_second_bucket[5m])) by (le))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, sum(rate(inference_output_tokens_per_second_bucket[5m])) by (le))", "legendFormat": "P95"}
      ],
      "fieldConfig": {"defaults": {"unit": "tokens/s", "min": 0}}
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Global Queue Depth",
      "description": "Active inference requests across all tenants",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 14},
      "targets": [{"expr": "inference_global_queue_depth"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 50, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 45}]}}}
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Active LoRA Adapters",
      "description": "Number of LoRA adapters loaded in vLLM (max 4)",
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 14},
      "targets": [{"expr": "active_adapters_loaded"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 4, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 4}]}}}
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "KV-Cache Utilization",
      "description": "vLLM GPU KV-cache occupancy",
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 14},
      "targets": [{"expr": "vllm_gpu_cache_usage_perc"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.90}]}}}
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "GPU Utilization %",
      "description": "DCGM — requires NVIDIA L4 + dcgm-exporter",
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 14},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "VRAM Utilization %",
      "description": "DCGM — requires NVIDIA L4 + dcgm-exporter",
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 14},
      "targets": [{"expr": "DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.80}, {"color": "red", "value": 0.92}]}}}
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "vLLM Requests Waiting",
      "description": "Requests queued in vLLM scheduler",
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 14},
      "targets": [{"expr": "vllm_num_requests_waiting"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 15}]}}}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rate Limit Rejections / min",
      "description": "429 and 503 rejections by reason",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 19},
      "targets": [{"expr": "rate(rate_limit_rejections_total[1m])", "legendFormat": "{{reason}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Error Rate / min",
      "description": "Inference errors by error code",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 19},
      "targets": [{"expr": "rate(inference_errors_total[1m])", "legendFormat": "{{error_code}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Prefix Cache Hit Rate",
      "description": "vLLM prefix cache effectiveness",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 19},
      "targets": [{"expr": "vllm_prefix_cache_hit_rate", "legendFormat": "Hit rate"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Adapter Load Attempts",
      "description": "LoRA adapter load success vs failure",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 26},
      "targets": [{"expr": "rate(adapter_load_total[5m])", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "vLLM — Requests Running / Waiting",
      "description": "Active vs queued sequences in vLLM",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 26},
      "targets": [
        {"expr": "vllm_num_requests_running", "legendFormat": "Running"},
        {"expr": "vllm_num_requests_waiting", "legendFormat": "Waiting"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "TTFT vLLM (internal)",
      "description": "vLLM's own TTFT histogram — compare with gateway TTFT to measure gateway overhead",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 26},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(vllm_time_to_first_token_seconds_bucket[5m])) by (le))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, sum(rate(vllm_time_to_first_token_seconds_bucket[5m])) by (le))", "legendFormat": "P95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    }
  ]
}
