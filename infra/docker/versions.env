# Pinned image and model versions for Inferra V1 beta
# All docker-compose.yml image references must use these tags (no :latest anywhere).
# Update this file when upgrading any component; commit the change with a version-bump commit message.

# vLLM — confirmed working version from Phase 1 RunPod validation (2026-08-29)
# vLLM 0.8.x+ uses the vllm/vllm-openai image series.
# Pin to the exact version confirmed against Qwen3-4B on L4 24 GB.
VLLM_IMAGE=vllm/vllm-openai:v0.8.5

# CUDA base image (used for custom builds; not referenced in dev docker-compose)
CUDA_IMAGE=nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# Infrastructure services — pinned for reproducibility
POSTGRES_IMAGE=postgres:16.3-alpine
REDIS_IMAGE=redis:7.2-alpine
PROMETHEUS_IMAGE=prom/prometheus:v2.52.0
GRAFANA_IMAGE=grafana/grafana:10.4.2
MINIO_IMAGE=minio/minio:RELEASE.2024-07-26T20-48-21Z

# Qwen3-4B model revision — HuggingFace git SHA of the exact checkpoint used.
# Run: git -C /workspace/models/Qwen3-4B rev-parse HEAD   (on the RunPod pod)
# and paste the SHA here before the beta tag.
QWEN3_4B_REVISION=PENDING-fill-in-from-pod

# vLLM runtime configuration (V1 production flags — Stage G)
# These match the flags in scripts/runpod/04_finalize_phase1.sh
VLLM_DTYPE=bfloat16
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_LORA_RANK=16
VLLM_MAX_LORAS=4
VLLM_ENABLE_PREFIX_CACHING=true
